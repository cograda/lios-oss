# Vault content (personal data — synced via Google Drive, never git)
vault/

# Fossil backups taken during the dev/day-to-day project split (contain a
# rotated bearer token — never commit)
.fossil-backup-*/

# Secrets and certificates
.env
*.env
server/.env
server/.env.*
!server/.env.example
server/certs/
client/certs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.venv/

# Node
node_modules/
frontend/dist/

# Proto generated stubs (regenerate with: make proto)
# Uncomment if you prefer to always regenerate:
# proto/generated/*.py
# proto/generated/*.pyi

# IDE / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Data files
*.csv
*.db
*.pkl
*.bin
*.mbox
*.gpx

# Health/export data (personal)
export/

# Historical corpus (personal WhatsApp/email/chat archives for embedding pipeline)
doc_corpus/

# Built client wheels (generated by CI, or locally via `make build-client`).
# Never commit an actual wheel — CI is the only supplier to the Docker image
# and a stale committed wheel has shadowed real releases before (0.1.0 hid
# 2.0.0+ for months). Keep the directory itself tracked via .gitkeep so a
# fresh checkout always has `server/client-dist/` for `docker build`'s
# `COPY client-dist/ client-dist/` to succeed even with zero wheels built yet.
server/client-dist/*
!server/client-dist/.gitkeep

# Logs
*.log
.claude/scheduled_tasks.lock
.mcp.json


# solar_forecast next-day-total research (research/README.md): the growing
# dataset and eval log are generated data pulled from HA statistics, not
# source — regenerable by build_dataset.py against the same HA instance.
server/backend/app/integrations/solar_forecast/research/dataset.json
server/backend/app/integrations/solar_forecast/research/eval_log.md
server/backend/app/integrations/solar_forecast/research/launchd.log
server/backend/app/integrations/solar_forecast/research/launchd.err.log

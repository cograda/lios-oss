<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cograda.reminders-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/scripts/reminders-sync/run.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>REMINDERS_SERVER_URL</key>
        <string>http://localhost:8400</string>
        <key>REMINDERS_AUTH_TOKEN</key>
        <string>YOUR_TOKEN_HERE</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/reminders-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/reminders-sync.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>

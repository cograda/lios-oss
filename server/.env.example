# Comar Server — Environment Variables
# Copy to .env and fill in required values.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Database ──────────────────────────────────────────────────
# App reads HOME_DATABASE__URL; docker-compose uses HOME_DB_USER/PASSWORD
HOME_DATABASE__URL=postgresql://homeservices:CHANGE_ME_GENERATE_A_RANDOM_PASSWORD@home-services-db:5432/home_services
HOME_DATABASE__ECHO=false
HOME_DB_USER=homeservices
HOME_DB_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD   # REQUIRED — also used by Postgres container; must match the password in HOME_DATABASE__URL above

# ── App ───────────────────────────────────────────────────────
HOME_DEBUG=false
HOME_PORT=8400                             # Host port mapping for HTTP API

# ── Authentication ────────────────────────────────────────────
HOME_UI_TOKEN=                             # REQUIRED — web dashboard access token
HOME_MCP_TOKEN=                            # REQUIRED — MCP endpoint bearer token
HOME_OAUTH_ENCRYPTION_KEY=                 # Recommended — Fernet key for OAuth token encryption
                                           # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Obsidian vault ────────────────────────────────────────────
HOME_OBSIDIAN_VAULT_PATH=/obsidian         # Path inside container (default)
HOME_VAULTS_HOST_PATH=                     # Host path to the vault tree (mounted into container).
                                           # Should contain a per-user subfolder, e.g. <this-path>/alex/
HOME_DOC_CORPUS_HOST_PATH=                 # Host path to the read-only historical/renovation document archive

# ── Google OAuth (Calendar + Gmail) ──────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/
# Enable Calendar API and Gmail API
HOME_GOOGLE_CLIENT_ID=
HOME_GOOGLE_CLIENT_SECRET=
HOME_OAUTH_REDIRECT_BASE=                  # Set to http://localhost:8400 for SSH tunnel auth

# ── Last.fm ───────────────────────────────────────────────────
# Get API key at https://www.last.fm/api/account/create
HOME_LASTFM_API_KEY=
HOME_LASTFM_USERNAME=

# ── WhatsApp bridge ──────────────────────────────────────────
HOME_WA_SYNC_HISTORY=false                 # Set true once for full history backfill
HOME_WA_BRIDGE_SHARED_SECRET=              # Recommended — shared secret sent as X-Bridge-Secret
                                           # to whatsapp-bridge's /download/:messageId. Must match
                                           # BRIDGE_SHARED_SECRET below. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_SHARED_SECRET=                      # Same value as HOME_WA_BRIDGE_SHARED_SECRET — read by
                                           # the whatsapp-bridge container itself

# ── Anthropic (for backlog sync) ─────────────────────────────
HOME_ANTHROPIC_API_KEY=                    # Haiku-powered task matching (optional)

# ── Home Assistant ────────────────────────────────────────────
HOME_HA_URL=
HOME_HA_TOKEN=

# ── Enable Banking / PSD2 (future) ──────────────────────────
HOME_BANKING_API_KEY=

# ── Location ──────────────────────────────────────────────────
HOME_WEATHER_LATITUDE=53.3498              # Weather forecast location (default: Dublin)
HOME_WEATHER_LONGITUDE=-6.2603
HOME_RAIL_STATION_CODE=MHIDE               # Irish Rail home station code (default: Malahide)
HOME_RAIL_STATION_NAME=Malahide

# ── Finance ───────────────────────────────────────────────────
# Account-holder names as they appear on bank statements, comma-separated.
# Used to classify Revolut "Transfer to/from <NAME>" between your own
# accounts as internal transfers.
HOME_TRANSFER_MATCH_NAMES=

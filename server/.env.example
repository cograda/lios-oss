# Comar Server — Environment Variables
# Copy to .env and fill in required values.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Database ──────────────────────────────────────────────────
# App reads HOME_DATABASE__URL; docker-compose uses HOME_DB_USER/PASSWORD
HOME_DATABASE__URL=postgresql://homeservices:changeme@home-services-db:5432/home_services
HOME_DATABASE__ECHO=false
HOME_DB_USER=homeservices
HOME_DB_PASSWORD=changeme                  # CHANGE THIS — also used by Postgres container

# ── App ───────────────────────────────────────────────────────
HOME_DEBUG=false
HOME_PORT=8400                             # Host port mapping for HTTP API

# ── Authentication ────────────────────────────────────────────
HOME_UI_TOKEN=                             # REQUIRED — web dashboard access token + OAuth Phase-0 login
# HOME_MCP_TOKEN removed (V4 chunk 2.3) — the shared-secret MCP admin
# fallback (synthesised user_id=1 for any bearer matching this var) was a
# standing impersonation path and has been deleted. MCP auth is per-user
# client_tokens or an OAuth 2.1 access token now — no shared secret.
HOME_OAUTH_ENCRYPTION_KEY=                 # REQUIRED (V4 chunk 3.3) — Fernet key. app/auth/encryption.py
                                           # is fail-closed: unset, any encrypt/decrypt of an OAuth token
                                           # or a secret integration_config value RAISES instead of
                                           # silently passing plaintext through. Must be set before
                                           # first boot with any Google account connected, and before
                                           # running `python -m app.plugin.import_config` if any
                                           # integration's config includes a secret key.
                                           # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HOME_OAUTH_PHASE0_ENABLE=false           # Set true to keep the claude.ai connector's
                                           # throwaway UI-token login working pre-Phase-1
                                           # (Google federation). Off by default (V4 chunk 2.3).

# ── Obsidian vault (kernel — Docker mount paths) ─────────────
HOME_OBSIDIAN_VAULT_PATH=/obsidian         # Path inside container (default)
HOME_OBSIDIAN_HOST_PATH=                   # Host path to vault (mounted into container)

# ── Google OAuth app registration (kernel — shared by every ──
# Google-scoped integration: calendar, gmail, sheets/drive) ──
# Create OAuth credentials at https://console.cloud.google.com/
# Enable Calendar API and Gmail API
HOME_GOOGLE_CLIENT_ID=
HOME_GOOGLE_CLIENT_SECRET=
HOME_OAUTH_REDIRECT_BASE=                  # Set to http://localhost:8400 for SSH tunnel auth

# ── Server-side Syncthing (kernel — used by both the kernel's ─
# /api/v1/syncthing/* pairing routes and obsidian's vault_transfer tool) ─
HOME_SYNCTHING_URL=http://172.21.0.1:8384
HOME_SYNCTHING_API_KEY=

# ── Per-integration config (V4 chunk 3.3) ────────────────────
# Everything below used to be its own HomeSettings field; it now lives in
# the `integration_config` DB table (declared by each integration's
# manifest `config_schema`, read via app.plugin.config_store.plugin_config()).
# These HOME_* vars still work as a one-release transition fallback
# (plugin_config() reads them if the DB has no row yet, logging a warning
# once per key) — set them here, then run:
#     python -m app.plugin.import_config
# to copy them into the DB. After that, manage values via
# GET/PUT /api/integrations/{name}/config instead of editing this file.

# Last.fm — get API key at https://www.last.fm/api/account/create
HOME_LASTFM_API_KEY=
HOME_LASTFM_USERNAME=

# WhatsApp bridge
HOME_WA_SYNC_HISTORY=false                 # Set true once for full history backfill
HOME_WHATSAPP_BRIDGE_URL=                  # Empty = integration's own docker-network default

# Home Assistant
HOME_HA_URL=
HOME_HA_TOKEN=
HOME_HA_RECORD_NUMERIC_HISTORY=false

# Commute solver (NTA GTFS-Realtime)
HOME_NTA_API_KEY=
HOME_COMMUTE_HOWTH_BUFFER_MIN=6
HOME_COMMUTE_SURFACE_DECISIONS=false
HOME_COMMUTE_ARRIVE_BY=08:57

# Apple Health push (Health Auto Export iOS app)
HOME_HEALTH_PUSH_TOKEN=

# Inbox (Tines webhook) — HOME_INBOX_PATH stays a kernel mount path (below)
HOME_INBOX_TOKEN=

# Google Sheets export (snags register) — owner account must already hold
# the spreadsheets + drive.file scopes (see app/auth/oauth.py::_oauth_scopes)
HOME_SHEETS_OWNER_ACCOUNT=
HOME_SHEETS_SHARE_WITH=[]

# ── Deployment vocabulary (personalisation, not platform) ─────
# These were hardcoded Python constants naming one household's rooms and one
# project's contractors. They are per-deployment data. Prefer setting them in
# the `integration_config` table via PUT /api/integrations/{snags,historical_corpus}/config;
# these env vars are the fallback the config store reads when no row exists.
# JSON-encoded (list / object), NOT comma-separated.
#
# IMPORTANT: HOME_TRADES drives the snag `trade` validation. It must list every
# trade already present in the `snags` table, or those rows can't be updated.
# Leave empty to fall back to the generic set in snags/vocab.py::DEFAULT_TRADES.
HOME_TRADES=[]
HOME_TRADE_LABELS={}
HOME_ROOM_ALIASES={}

# Project tag applied to ingested corpus documents when the caller doesn't
# specify one. Existing rows keep whatever tag they were ingested with.
HOME_DEFAULT_PROJECT_TAG=household

# Anthropic — reserved for Haiku-powered backlog task matching (not yet wired up)
HOME_ANTHROPIC_API_KEY=

# Enable Banking / PSD2 — reserved (not yet wired up)
HOME_BANKING_API_KEY=

# ── Inbox / media (kernel — Docker mount paths) ──────────────
HOME_INBOX_PATH=/inbox
HOME_MEDIA_ROOT=/data/media

# ── gRPC ──────────────────────────────────────────────────────
HOME_GRPC_PORT=9443                        # gRPC port (native TLS)
